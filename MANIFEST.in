graft src

prune .github

prune data
prune docs
prune examples
prune rhino_plugin
prune scripts
prune temp
prune tests

# Excluded from the package in pyproject.toml; pruned here so that
# include-package-data does not ship their .py files as data.
prune src/compas_singular/algorithms/unused
prune src/compas_singular/rhino/geometry
prune src/compas_singular.egg-info

include LICENSE
include README.md
include AUTHORS.md
include CHANGELOG.md
include pyproject.toml

# setuptools-scm adds every git-tracked file to the sdist; these are the ones not pruned above.
exclude .editorconfig .gitignore environment.yml mkdocs.yml
exclude tasks.py
exclude CONTRIBUTING.md

global-exclude *.py[cod] __pycache__ *.dylib *.nb[ic] .DS_Store